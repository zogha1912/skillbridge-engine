# Copy this file to .env and fill in real values. Never commit .env.

# Application
APP_NAME=SkillBridge Engine
ENVIRONMENT=development
DEBUG=false

# Neon PostgreSQL. `neon checkout <branch>` / `neon env pull` fill these in for you.
# DATABASE_URL          = pooled endpoint ("-pooler" host), used by the app
# DATABASE_URL_UNPOOLED = direct endpoint, used by Alembic migrations
# sslmode/channel_binding are handled automatically for asyncpg.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-123456-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-example-123456.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Connection pool (kept small for Neon's free tier)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300

# Log every SQL statement (local debugging only; logs can contain personal data)
DB_ECHO=false

# Google Gemini API (https://aistudio.google.com/apikey). Used for taxonomy embeddings.
# Free tier: public taxonomy data only; Google may use free-tier inputs to improve its products.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
